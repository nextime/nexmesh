/target/
# Hub state and node sockets are runtime artefacts, never committed.
*.db
*.db-wal
*.db-shm
*.sock
# Per-workspace agent state the node writes next to a project.
.nexmesh/
# Files handed to the team land in the workspace, which may be a checkout of
# this very repository. A photo or a recording from somebody's webcam is not
# something `git add -A` should ever be able to pick up.
/uploads/
# Notes agents leave for each other in the tree. They are addressed to
# somebody here, not to whoever clones this, and they tend to carry the
# addresses of real machines -- which is exactly what a public repository
# must not learn.
/docs/*HANDOFF*.md
/docs/*-handoff-*.md
tests/__pycache__/
