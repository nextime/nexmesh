#!/usr/bin/env python3
"""A minimal interactive 'agent': proves pty allocation and takeover.

Prints a banner, then echoes whatever is typed. Reports whether it is on a tty,
which is the thing an attach test actually needs to verify.
"""
import sys, os
if "--version" in sys.argv:
    print("faketui 1.0.0"); sys.exit(0)
tty = sys.stdin.isatty()
print(f"FAKETUI READY tty={tty} term={os.environ.get('TERM','?')}", flush=True)
print("agent> ", end="", flush=True)
for line in sys.stdin:
    line = line.strip()
    if line in ("quit", "exit"):
        print("\nbye", flush=True); break
    print(f"\nyou said: {line}", flush=True)
    print("agent> ", end="", flush=True)
